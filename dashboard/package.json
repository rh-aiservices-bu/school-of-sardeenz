{
  "name": "@sardeenz/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:logged": "mkdir -p ../logs && vite 2>&1 | tee ../logs/dashboard.log",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:server:logged": "mkdir -p ../logs && node --watch --import tsx server/index.ts 2>&1 | tee ../logs/dashboard-server.log",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "logs": "tail -f ../logs/dashboard.log",
    "logs:server": "tail -f ../logs/dashboard-server.log",
    "logs:clear": "rm -f ../logs/dashboard.log ../logs/dashboard-server.log"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/static": "^9.1.3",
    "@patternfly/react-charts": "^8.0.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@patternfly/react-table": "^6.0.0",
    "@sardeenz/types": "*",
    "@tanstack/react-query": "^5.0.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.28.0",
    "undici": "^7.10.0",
    "victory": "^37.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.3"
  }
}
