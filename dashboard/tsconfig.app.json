{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "rootDir": "src",
    "baseUrl": "..",
    "paths": {
      "@sardeenz/types": ["packages/types/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "include": ["src"],
  "references": [{ "path": "../packages/types" }]
}
