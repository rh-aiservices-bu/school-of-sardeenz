{
  "name": "sardeenz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "control-plane",
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "npm run codegen -w @sardeenz/types"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "^1.34.0",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.2.1"
  }
}
