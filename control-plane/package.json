{
  "name": "@sardeenz/control-plane",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch --import tsx src/index.ts",
    "dev:logged": "mkdir -p ../logs && node --watch --import tsx src/index.ts 2>&1 | tee ../logs/control-plane.log",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "logs": "tail -f ../logs/control-plane.log",
    "logs:clear": "rm -f ../logs/control-plane.log"
  },
  "dependencies": {
    "@sardeenz/types": "*",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "undici": "^7.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.14",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.3"
  }
}
