    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sardeenz/types": "*",
    "dotenv": "^17.0.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
