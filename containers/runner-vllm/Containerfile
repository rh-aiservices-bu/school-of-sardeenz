# Sardeenz runner-vllm — the vLLM (+ kvcached) runner image that becomes a SIF.
#
# This image is NOT run as a container in production: CI builds+signs it, then a librarian job
# converts it to a signed SIF on the shared module volume, and a worker `apptainer exec`s that SIF.
# See docs/architecture/adrs/adr-015-sif-runtime-packaging.md and adr-017-runner-image-pipeline.md,
# and docs/project/phase4.md (Task 3).
#
# Derived from the Sardeenz v1 docker/Containerfile, stripped to just the vLLM + kvcached stages
# (no Node/app). kvcached is NOT in the base image: it is a wheel compiled from a pinned
# ovg-project/kvcached commit and installed on top; at runtime it autopatches vLLM when
# ENABLE_KVCACHED=1 + KVCACHED_AUTOPATCH=1 (vLLM itself is not statically patched).
#
# PIN DISCIPLINE: the base image tag and KVCACHED_VERSION are pinned together. On any bump,
# re-run the kvcached co-tenancy gate (spike Gate 9d) before publishing. Keep these in sync with
# the CUDA -devel versions below (they must match the base image's CUDA).

# ---------------------------------------------------------------------------------------------
# Stage 0: vLLM base
# ---------------------------------------------------------------------------------------------
FROM quay.io/vllm/vllm-cuda:0.21.0_rhaiv.8 AS vllm-base
USER 0
RUN microdnf -y update && microdnf clean all && rm -rf /var/cache/yum/*

# ---------------------------------------------------------------------------------------------
# Stage 1: kvcached builder — CUDA devel toolchain (no GPU needed; links against CUDA stubs)
# ---------------------------------------------------------------------------------------------
FROM vllm-base AS kvcached-builder

# Pinned kvcached commit (carries the KV-cache reshape patch adapted up to recent vLLM).
ARG KVCACHED_VERSION=094481f3f77c53ad2edc13369b84eb42bbf082a1

# CUDA -devel package versions — MUST match the base image's CUDA (13.0 here).
ENV NV_CUDA_LIB_VERSION=13.0.3-1 \
    NV_CUDA_CUDART_DEV_VERSION=13.0.96-1 \
    NV_NVML_DEV_VERSION=13.0.87-1 \
    NV_LIBCUBLAS_DEV_VERSION=13.1.1.3-1 \
    NV_LIBNPP_DEV_VERSION=13.0.1.2-1 \
    NV_LIBNCCL_PACKAGE=libnccl-2.28.9-1+cuda13.0 \
    NV_LIBNCCL_DEV_PACKAGE=libnccl-devel-2.28.9-1+cuda13.0 \
    NV_CUDA_NSIGHT_COMPUTE_VERSION=13.0.3-1

RUN microdnf install -y \
      git \
      cuda-command-line-tools-13-0-${NV_CUDA_LIB_VERSION} \
      cuda-libraries-devel-13-0-${NV_CUDA_LIB_VERSION} \
      cuda-minimal-build-13-0-${NV_CUDA_LIB_VERSION} \
      cuda-cudart-devel-13-0-${NV_CUDA_CUDART_DEV_VERSION} \
      cuda-nvml-devel-13-0-${NV_NVML_DEV_VERSION} \
      libcublas-devel-13-0-${NV_LIBCUBLAS_DEV_VERSION} \
      libnpp-devel-13-0-${NV_LIBNPP_DEV_VERSION} \
      ${NV_LIBNCCL_PACKAGE} \
      ${NV_LIBNCCL_DEV_PACKAGE} \
      cuda-nsight-compute-13-0-${NV_CUDA_NSIGHT_COMPUTE_VERSION} && \
    microdnf clean all && rm -rf /var/cache/yum/*

WORKDIR /build
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs${LIBRARY_PATH:+:${LIBRARY_PATH}}
RUN git init kvcached && cd kvcached && \
    git remote add origin https://github.com/ovg-project/kvcached.git && \
    git fetch --depth 1 origin ${KVCACHED_VERSION} && \
    git checkout FETCH_HEAD && \
    pip3.12 wheel . --no-build-isolation --wheel-dir /wheels

# ---------------------------------------------------------------------------------------------
# Stage 2: runtime — base vLLM + kvcached wheel + enablement env (this is what becomes the SIF)
# ---------------------------------------------------------------------------------------------
FROM vllm-base AS runtime

COPY --from=kvcached-builder /wheels/*.whl /wheels/
RUN pip install --no-cache-dir /wheels/kvcached*.whl && rm -rf /wheels

# kvcached enablement — autopatches vLLM at import. (Apptainer bakes these into the SIF env; the
# worker agent also passes them via --env to be explicit.)
# HF_HUB_OFFLINE=1: runners never phone home at runtime; weights are pre-staged on the weights
# volume. Set explicitly here so it's load-bearing regardless of the base image's default. The
# librarian's model-staging step (not the runner) overrides it with --env HF_HUB_OFFLINE=0.
ENV ENABLE_KVCACHED=true \
    KVCACHED_AUTOPATCH=1 \
    HF_HUB_OFFLINE=1

# NOTE ON CACHES: this base image points XDG_CACHE_HOME / HF_HOME / FLASHINFER_WORKSPACE_DIR under
# /opt/app-root/src, which is READ-ONLY inside a SIF. The worker agent MUST redirect those to a
# node-local writable path (/scratch) at exec time (spike Gate 9d finding) — do NOT rely on the
# baked values at runtime.
#
# TODO (Phase 4, Task 5): COPY in the vLLM runner-contract shim (runners/vllm) and set it as the
# default entrypoint so `apptainer exec <sif> <shim>` starts the shim → vLLM. Until the shim
# exists, the worker agent invokes `vllm serve …` directly (validated in spike Gate 9).

CMD ["sleep", "infinity"]
